# Groq API Configuration (Для быстрого инференса)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Configuration (Для мультимодельных запросов)
OPENROUTER_API_KEY_1=your_openrouter_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_key_2_here

# Настройки агентов
AXIOM_MEDIC_MODEL=openai/gpt-oss-120b
